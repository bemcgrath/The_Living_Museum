# Copy to .env.local for local dev (Vercel CLI) and set the same values in the Vercel project's
# Environment Variables for production. None of these are used by the browser app (see src/) —
# they're read only by the serverless functions in api/ and lib/server/.

# --- Supabase (subscriber database) ---
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
# The SERVICE ROLE key, not the anon key — these functions run server-side and need to bypass RLS
# to manage subscribers. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (billing) ---
# Developers -> API keys. Use the sk_test_... key until you're ready to go live.
STRIPE_SECRET_KEY=
# The recurring $1/month Price ID you create in the Stripe Dashboard (Products -> add a product ->
# add a recurring price). The 7-day trial is set at checkout time (see api/subscribe.ts), not on
# the Price itself, so one Price object is all you need.
STRIPE_PRICE_ID=
# Developers -> Webhooks -> add endpoint (https://<your-domain>/api/webhooks/stripe), then copy the
# signing secret it gives you.
STRIPE_WEBHOOK_SECRET=

# --- Resend (email delivery) ---
RESEND_API_KEY=
# Must be a domain you've verified in Resend (or onboarding@resend.dev for early testing).
RESEND_FROM_EMAIL="The Living Museum <art@yourdomain.com>"

# --- Image generation ---
# 'xai' (Grok Imagine, default, mid-quality tier ~$0.05/image) or 'openai' (gpt-image-1, ~$0.07/image
# medium tier). See lib/server/imageProvider.ts.
IMAGE_PROVIDER=xai
XAI_API_KEY=
OPENAI_API_KEY=

# --- Cron protection ---
# A random secret string. The weekly cron endpoint (api/cron/weekly-art.ts) requires this as a
# Bearer token so the (otherwise public) URL can't be hit by anyone to trigger paid image generation.
# Set the same value as the Authorization header in Vercel's Cron Job configuration.
CRON_SECRET=

# --- Site ---
# Used to build links back to the app from emails.
SITE_URL=http://localhost:5173
